<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
 android:padding="8dp" android:background="@android:color/transparent">
 <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:text="예안버스" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"
  android:shadowColor="#80000000" android:shadowRadius="2" android:shadowDy="1" />
 <TextView android:id="@+id/widget_arrivals" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
  android:textColor="#FFFFFF" android:textSize="13sp" android:paddingTop="8dp" android:lineSpacingExtra="4dp" android:gravity="center_vertical"
  android:shadowColor="#80000000" android:shadowRadius="2" android:shadowDy="1" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
  <TextView android:id="@+id/widget_refresh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
   android:gravity="center" android:text="새로고침" android:textColor="#FFFFFF" android:textSize="12sp"
   android:shadowColor="#80000000" android:shadowRadius="2" android:shadowDy="1" />
  <TextView android:id="@+id/widget_settings" android:layout_width="48dp" android:layout_height="match_parent"
   android:gravity="center" android:text="설정" android:textColor="#FFFFFF" android:textSize="12sp"
   android:shadowColor="#80000000" android:shadowRadius="2" android:shadowDy="1" />
 </LinearLayout>
</LinearLayout>